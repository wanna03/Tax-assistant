
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Withholding Tax Assistant</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f4f6fa;color:#202b3c}
header{background:#17365d;color:white;padding:28px 18px;text-align:center}
header h1{margin:0 0 8px;font-size:25px}
header p{margin:0;color:#dce8f7}
main{max-width:850px;margin:25px auto;padding:0 15px}
.card{background:white;padding:22px;border-radius:14px;margin-bottom:18px;box-shadow:0 3px 14px #172b4d12}
h2{font-size:19px;margin-top:0}
label{display:block;font-weight:bold;margin:14px 0 7px}
select,input{width:100%;padding:12px;border:1px solid #ccd4df;border-radius:8px;font-size:16px;background:white}
button{background:#1d5fa7;color:white;border:0;padding:13px 20px;border-radius:8px;font-size:16px;cursor:pointer;margin-top:18px;width:100%}
button:hover{background:#174b84}
.result{display:none;line-height:1.8}
.result h2{color:#17365d}
.notice{background:#fff5d9;padding:12px;border-radius:8px;font-size:14px}
.good{background:#e7f6ed;padding:12px;border-radius:8px}
.bad{background:#fdecec;padding:12px;border-radius:8px}
.small{font-size:13px;color:#667085}
footer{text-align:center;padding:25px;color:#667085;font-size:13px}
</style>
</head>
<body>
<header>
<h1>AI Withholding Tax Assistant</h1>
<p>ระบบต้นแบบช่วยวิเคราะห์ภาษีหัก ณ ที่จ่าย</p>
</header>
<main>
<section class="card">
<h2>ข้อมูลรายการจ่ายเงิน</h2>
<p class="small">ระบบใช้กฎและเงื่อนไขที่กำหนดไว้ ไม่ได้ใช้ AI API</p>

<label>เลือกกรณีค่าใช้จ่าย</label>
<select id="caseType">
<option value="">-- เลือกรายการ --</option>
<option value="1">1. ค่าเช่าสำนักงานให้บริษัท</option>
<option value="2">2. ค่าเช่าอาคารให้บุคคลธรรมดา</option>
<option value="3">3. ค่าบริการทำความสะอาด</option>
<option value="4">4. ค่าจ้างทำชั้นวางเอกสารพร้อมวัสดุ</option>
<option value="5">5. ค่าโฆษณา</option>
<option value="6">6. ค่าขนส่งสินค้า</option>
<option value="7">7. ซื้อสินค้าและมีค่าจัดส่งแยก</option>
<option value="8">8. ค่าที่พักโรงแรม</option>
<option value="9">9. ค่าอาหารประชุมในภัตตาคาร</option>
<option value="10">10. ค่าดำเนินการ (ข้อมูลไม่ครบ)</option>
</select>

<label>จำนวนเงินก่อน VAT (บาท)</label>
<input id="amount" type="number" min="0" placeholder="เช่น 30000">

<div id="extraBox"></div>
<button onclick="analyze()">วิเคราะห์ภาษี</button>
</section>

<section class="card result" id="result">
<h2>ผลการวิเคราะห์</h2>
<div id="output"></div>
</section>

<section class="card">
<h2>ข้อมูลร่วมของโจทย์ทดสอบ</h2>
<p>ผู้จ่ายเงิน: บริษัท ABC จำกัด ซึ่งจัดตั้งในประเทศไทย</p>
<p>วันที่จ่ายเงิน: 9 พฤศจิกายน 2569</p>
<p>ใช้อัตราภาษีปกติ ไม่ใช้อัตราพิเศษ e-Withholding Tax</p>
</section>

<section class="card">
<h2>ข้อจำกัดของระบบ</h2>
<p class="small">เป็นระบบต้นแบบ Rule-Based ที่ประมวลผลตามกรณีและเงื่อนไขที่ผู้พัฒนากำหนด ไม่สามารถวิเคราะห์ข้อเท็จจริงนอกเหนือจากกฎที่เขียนไว้ได้ ผลลัพธ์ต้องตรวจสอบกับกฎหมายฉบับปัจจุบันก่อนนำไปใช้จริง</p>
</section>
</main>
<footer>AI Withholding Tax Assistant · Prototype</footer>

<script>
const cases = {
1:{name:"ค่าเช่าสำนักงานให้บริษัท",rate:5,section:"มาตรา 40(5)(ก)",form:"ภ.ง.ด.53",law:"คำสั่งกรมสรรพากรที่ ท.ป.4/2528 ข้อ 6",note:"ค่าเช่าทรัพย์สิน"},
2:{name:"ค่าเช่าอาคารให้บุคคลธรรมดา",rate:5,section:"มาตรา 40(5)(ก)",form:"ภ.ง.ด.3",law:"คำสั่งกรมสรรพากรที่ ท.ป.4/2528 ข้อ 6",note:"ค่าเช่าทรัพย์สิน"},
3:{name:"ค่าบริการทำความสะอาด",rate:3,section:"มาตรา 40(8)",form:"ภ.ง.ด.53",law:"คำสั่งกรมสรรพากรที่ ท.ป.4/2528 ข้อ 12/1",note:"คำนวณจากค่าบริการก่อน VAT"},
4:{name:"ค่าจ้างทำชั้นวางพร้อมวัสดุ",rate:3,section:"มาตรา 40(7)",form:"ภ.ง.ด.3",law:"คำสั่งกรมสรรพากรที่ ท.ป.4/2528 ข้อ 8(1)",note:"สมมติว่าวัสดุเป็นสาระสำคัญของงาน"},
5:{name:"ค่าโฆษณา",rate:2,section:"มาตรา 40(8)",form:"ภ.ง.ด.53",law:"คำสั่งกรมสรรพากรที่ ท.ป.4/2528 ข้อ 10",note:"คำนวณจากค่าโฆษณาก่อน VAT"},
6:{name:"ค่าขนส่งสินค้า",rate:1,section:"มาตรา 40(8)",form:"ภ.ง.ด.53",law:"คำสั่งกรมสรรพากรที่ ท.ป.4/2528 ข้อ 12/4",note:"สมมติเป็นผู้ประกอบธุรกิจขนส่ง"},
8:{name:"ค่าที่พักโรงแรม",rate:0,section:"ต้องพิจารณาลักษณะบริการ",form:"ไม่ต้องนำส่งจากรายการนี้",law:"คำสั่งกรมสรรพากรที่ ท.ป.4/2528 ข้อ 12/1",note:"สมมติเป็นค่าที่พักโรงแรมโดยตรง"},
9:{name:"ค่าอาหารประชุมในภัตตาคาร",rate:0,section:"ต้องพิจารณาลักษณะบริการ",form:"ไม่ต้องนำส่งจากรายการนี้",law:"คำสั่งกรมสรรพากรที่ ท.ป.4/2528 ข้อ 12/1 และ ท.ป.104/2544",note:"สมมติเป็นค่าอาหารภัตตาคารโดยตรง"}
};

document.getElementById("caseType").addEventListener("change",function(){
 const v=this.value;
 const box=document.getElementById("extraBox");
 box.innerHTML="";
 if(v==="7"){
  box.innerHTML='<label>ใครเป็นผู้ได้รับค่าจัดส่ง?</label><select id="delivery"><option value="">-- เลือก --</option><option value="seller">ผู้ขายสินค้าได้รับค่าจัดส่งเอง และเป็นส่วนหนึ่งของการขาย</option><option value="carrier">จ่ายให้บริษัทขนส่งอิสระโดยตรง</option></select>';
 }
 if(v==="10"){
  box.innerHTML='<div class="notice">กรณีนี้ต้องขอข้อมูลเพิ่มเติมก่อนสรุปผล</div><label>ผู้รับเงินเป็นใคร?</label><select id="recipient"><option value="">-- เลือก --</option><option>บุคคลธรรมดา</option><option>บริษัท/ห้างหุ้นส่วนนิติบุคคล</option></select><label>รายละเอียดงาน</label><input id="job" placeholder="อธิบายว่าจ้างให้ทำอะไร"><label>ลักษณะการทำงาน</label><select id="work"><option value="">-- เลือก --</option><option>ลูกจ้าง</option><option>ผู้รับจ้างอิสระ</option><option>ตัวแทน/นายหน้า</option><option>เบิกคืนค่าใช้จ่าย</option><option>อื่น ๆ / ไม่แน่ใจ</option></select>';
 }
});

function analyze(){
 const type=document.getElementById("caseType").value;
 const amount=Number(document.getElementById("amount").value);
 const result=document.getElementById("result");
 const output=document.getElementById("output");
 result.style.display="block";
 if(!type){output.innerHTML='<div class="bad">กรุณาเลือกรายการค่าใช้จ่ายก่อน</div>';return;}
 if(type!=="10" && (!amount || amount<0)){output.innerHTML='<div class="bad">กรุณากรอกจำนวนเงินให้ถูกต้อง</div>';return;}
 if(type==="10"){
  const recipient=document.getElementById("recipient")?.value;
  const job=document.getElementById("job")?.value.trim();
  const work=document.getElementById("work")?.value;
  let missing=[];
  if(!recipient)missing.push("ประเภทผู้รับเงิน");
  if(!job)missing.push("รายละเอียดงาน");
  if(!work)missing.push("ลักษณะการทำงาน");
  output.innerHTML='<div class="notice"><b>ยังไม่สามารถสรุปผลภาษีได้</b><br>ระบบต้องขอข้อมูลเพิ่มเติม ได้แก่ '+(missing.length?missing.join("、"):"ข้อมูล VAT และเอกสารประกอบ รวมถึงรายละเอียดความสัมพันธ์ในการจ้าง")+'<br>ห้ามกำหนดประเภทเงินได้ อัตราภาษี หรือแบบนำส่งจนกว่าจะมีข้อเท็จจริงเพียงพอ</div>';
  return;
 }
 if(type==="7"){
  const delivery=document.getElementById("delivery")?.value;
  if(!delivery){output.innerHTML='<div class="notice">กรุณาระบุผู้ได้รับค่าจัดส่งก่อน ระบบยังไม่สามารถสรุปผลได้</div>';return;}
  if(delivery==="seller"){
   output.innerHTML='<div class="good"><b>ผลเบื้องต้น: ไม่หักภาษี ณ ที่จ่ายจากค่าจัดส่ง</b><br>สมมติว่าค่าจัดส่งเป็นส่วนหนึ่งของการขายสินค้าและผู้ขายไม่ได้ประกอบธุรกิจขนส่งเป็นปกติ ต้องตรวจสอบสัญญาและใบแจ้งหนี้ประกอบ</div>';
   return;
  }
  output.innerHTML='<div class="notice"><b>ต้องตรวจสอบข้อมูลเพิ่มเติม</b><br>กรณีจ่ายให้ผู้ขนส่งอิสระโดยตรง ต้องยืนยันสถานะผู้รับเงิน ลักษณะธุรกิจ และเอกสารการขนส่งก่อนกำหนดอัตราและแบบนำส่ง</div>';
  return;
 }
 const c=cases[type];
 const wht=amount*c.rate/100;
 const net=amount-wht;
 output.innerHTML='<p><b>รายการ:</b> '+c.name+'</p>'+
 '<p><b>ประเภทเงินได้:</b> '+c.section+'</p>'+
 '<p><b>อัตราหักภาษี:</b> '+c.rate+'%</p>'+
 '<p><b>ฐานกฎหมายเบื้องต้น:</b> '+c.law+'</p>'+
 '<p><b>จำนวนเงินก่อน VAT:</b> '+amount.toLocaleString('th-TH',{minimumFractionDigits:2})+' บาท</p>'+
 '<p><b>ภาษีหัก ณ ที่จ่าย:</b> '+wht.toLocaleString('th-TH',{minimumFractionDigits:2})+' บาท</p>'+
 '<p><b>ยอดสุทธิหลังหักภาษี:</b> '+net.toLocaleString('th-TH',{minimumFractionDigits:2})+' บาท</p>'+
 '<p><b>แบบนำส่ง:</b> '+c.form+'</p>'+
 '<p><b>ข้อสังเกต:</b> '+c.note+'</p>'+
 '<div class="notice">ผลนี้เป็นผลจากกฎที่กำหนดในต้นแบบ ต้องตรวจสอบข้อเท็จจริง เอกสาร และกฎหมายฉบับที่มีผลในวันที่จ่ายเงินจริงก่อนนำไปใช้</div>';
}
</script>
</body>
</html>
